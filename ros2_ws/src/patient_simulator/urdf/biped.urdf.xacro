<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="biped_patient">

  <material name="dark_gray"><color rgba="0.3 0.3 0.3 1"/></material>

  <link name="world"/>

  <link name="base_x_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="base_x_joint" type="prismatic">
    <parent link="world"/>
    <child link="base_x_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-100.0" upper="100.0" effort="1000" velocity="10"/>
  </joint>

  <link name="base_z_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="base_z_joint" type="prismatic">
    <parent link="base_x_link"/>
    <child link="base_z_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="10.0" effort="1000" velocity="10"/>
  </joint>

  <link name="pelvis_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.983"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/pelvis.STL"/>
      </geometry>
    </visual>
  </link>

  <joint name="base_pitch_joint" type="revolute">
    <parent link="base_z_link"/>
    <child link="pelvis_link"/>
    <origin xyz="0 0 1.0242" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="10"/>
  </joint>

  <link name="L_thigh_link">
    <inertial>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <mass value="4.953"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/left_hip_pitch_link.STL"/>
      </geometry>
    </visual>
  </link>
  <joint name="L_hip_joint" type="revolute">
    <parent link="pelvis_link"/>
    <child link="L_thigh_link"/>
    <origin xyz="0.039468 0.20286 -0.1742" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.75" upper="1.75" effort="200" velocity="23"/>
  </joint>

  <link name="L_shank_link">
    <inertial>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/left_knee_link.STL"/>
      </geometry>
    </visual>
  </link>
  <joint name="L_knee_joint" type="revolute">
    <parent link="L_thigh_link"/>
    <child link="L_shank_link"/>
    <origin xyz="0 0 -0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.05" effort="300" velocity="14"/>
  </joint>

  <link name="L_foot_link">
    <inertial>
      <origin xyz="0.05 0 -0.02" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/left_ankle_link.STL"/>
      </geometry>
    </visual>
  </link>
  <joint name="L_ankle_joint" type="revolute">
    <parent link="L_shank_link"/>
    <child link="L_foot_link"/>
    <origin xyz="0 0 -0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.87" upper="0.52" effort="40" velocity="9"/>
  </joint>

  <link name="R_thigh_link">
    <inertial>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <mass value="4.953"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/right_hip_pitch_link.STL"/>
      </geometry>
    </visual>
  </link>
  <joint name="R_hip_joint" type="revolute">
    <parent link="pelvis_link"/>
    <child link="R_thigh_link"/>
    <origin xyz="0.039468 -0.20286 -0.1742" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.75" upper="1.75" effort="200" velocity="23"/>
  </joint>

  <link name="R_shank_link">
    <inertial>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/right_knee_link.STL"/>
      </geometry>
    </visual>
  </link>
  <joint name="R_knee_joint" type="revolute">
    <parent link="R_thigh_link"/>
    <child link="R_shank_link"/>
    <origin xyz="0 0 -0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.05" effort="300" velocity="14"/>
  </joint>

  <link name="R_foot_link">
    <inertial>
      <origin xyz="0.05 0 -0.02" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/right_ankle_link.STL"/>
      </geometry>
    </visual>
  </link>
  <joint name="R_ankle_joint" type="revolute">
    <parent link="R_shank_link"/>
    <child link="R_foot_link"/>
    <origin xyz="0 0 -0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.87" upper="0.52" effort="40" velocity="9"/>
  </joint>

  <link name="torso_link">
    <inertial>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.3" ixy="0" ixz="0" iyy="0.3" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/torso_link.STL"/>
      </geometry>
    </visual>
  </link>
  <joint name="torso_joint" type="fixed">
    <parent link="pelvis_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="L_shoulder_pitch_link">
    <visual>
      <geometry><mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/left_shoulder_pitch_link.STL"/></geometry>
    </visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="L_shoulder_pitch_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="L_shoulder_pitch_link"/>
    <origin xyz="0.0055 0.15535 0.42999" rpy="0.43633 0 0"/>
  </joint>

  <link name="L_shoulder_roll_link">
    <visual>
      <geometry><mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/left_shoulder_roll_link.STL"/></geometry>
    </visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="L_shoulder_roll_joint" type="fixed">
    <parent link="L_shoulder_pitch_link"/>
    <child link="L_shoulder_roll_link"/>
    <origin xyz="-0.0055 0.0565 -0.0165" rpy="-0.43633 0 0"/>
  </joint>

  <link name="L_shoulder_yaw_link">
    <visual>
      <geometry><mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/left_shoulder_yaw_link.STL"/></geometry>
    </visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="L_shoulder_yaw_joint" type="fixed">
    <parent link="L_shoulder_roll_link"/>
    <child link="L_shoulder_yaw_link"/>
    <origin xyz="0 0 -0.1343" rpy="0 0 0"/>
  </joint>

  <link name="L_elbow_link">
    <visual>
      <geometry><mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/left_elbow_link.STL"/></geometry>
    </visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="L_elbow_joint" type="fixed">
    <parent link="L_shoulder_yaw_link"/>
    <child link="L_elbow_link"/>
    <origin xyz="0.0185 0 -0.198" rpy="0 0 0"/>
  </joint>

  <link name="R_shoulder_pitch_link">
    <visual>
      <geometry><mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/right_shoulder_pitch_link.STL"/></geometry>
    </visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="R_shoulder_pitch_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="R_shoulder_pitch_link"/>
    <origin xyz="0.0055 -0.15535 0.42999" rpy="-0.43633 0 0"/>
  </joint>

  <link name="R_shoulder_roll_link">
    <visual>
      <geometry><mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/right_shoulder_roll_link.STL"/></geometry>
    </visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="R_shoulder_roll_joint" type="fixed">
    <parent link="R_shoulder_pitch_link"/>
    <child link="R_shoulder_roll_link"/>
    <origin xyz="-0.0055 -0.0565 -0.0165" rpy="0.43633 0 0"/>
  </joint>

  <link name="R_shoulder_yaw_link">
    <visual>
      <geometry><mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/right_shoulder_yaw_link.STL"/></geometry>
    </visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="R_shoulder_yaw_joint" type="fixed">
    <parent link="R_shoulder_roll_link"/>
    <child link="R_shoulder_yaw_link"/>
    <origin xyz="0 0 -0.1343" rpy="0 0 0"/>
  </joint>

  <link name="R_elbow_link">
    <visual>
      <geometry><mesh filename="file:///workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/meshes/h1/right_elbow_link.STL"/></geometry>
    </visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="R_elbow_joint" type="fixed">
    <parent link="R_shoulder_yaw_link"/>
    <child link="R_elbow_link"/>
    <origin xyz="0.0185 0 -0.198" rpy="0 0 0"/>
  </joint>

  <ros2_control name="PatientHardware" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="base_x_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_z_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="L_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="L_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="L_ankle_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="R_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="R_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="R_ankle_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="patient_gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <ros>
        <namespace>/patient</namespace>
      </ros>
      <parameters>$(find patient_simulator)/config/patient_controllers.yaml</parameters>
      <controller_manager_node_name>controller_manager</controller_manager_node_name>
      <robot_param>robot_description</robot_param>
      <robot_param_node>patient_state_publisher</robot_param_node>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="patient_p3d" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/patient</namespace>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <body_name>pelvis_link</body_name>
      <frame_name>world</frame_name>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

</robot>
