<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="biped_patient">
  
  <xacro:property name="ctrl_yaml" value="/workspace/go2-stair-climber/ros2_ws/install/patient_simulator/share/patient_simulator/config/patient_controllers.yaml"/>
  
  <xacro:property name="pelvis_w" value="0.30"/>
  <xacro:property name="pelvis_h" value="0.20"/>
  <xacro:property name="pelvis_d" value="0.18"/>
  
  <xacro:property name="thigh_length" value="0.38"/>
  <xacro:property name="thigh_radius" value="0.08"/>
  
  <xacro:property name="shank_length" value="0.38"/>
  <xacro:property name="shank_radius" value="0.06"/>
  
  <xacro:property name="foot_length" value="0.20"/>
  <xacro:property name="foot_width" value="0.09"/>
  <xacro:property name="foot_height" value="0.04"/>
  
  <xacro:property name="hip_offset_y" value="0.10"/>
  
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0"
             izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>
  
  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertia ixx="${m*(3*r*r+l*l)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+l*l)/12}" iyz="0"
             izz="${m*r*r/2}"/>
  </xacro:macro>
  
  <link name="world"/>
  
  <link name="base_x_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <joint name="base_x_joint" type="prismatic">
    <parent link="world"/>
    <child link="base_x_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-100" upper="100" effort="10000" velocity="5"/>
  </joint>
  
  <link name="base_z_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <joint name="base_z_joint" type="prismatic">
    <parent link="base_x_link"/>
    <child link="base_z_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="5" effort="10000" velocity="5"/>
  </joint>
  
  <joint name="base_pitch_joint" type="revolute">
    <parent link="base_z_link"/>
    <child link="pelvis_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" effort="10000" velocity="5"/>
  </joint>
  
  <link name="pelvis_link">
    <inertial>
      <mass value="10.0"/>
      <xacro:box_inertia m="10.0" x="${pelvis_d}" y="${pelvis_w}" z="${pelvis_h}"/>
    </inertial>
    <visual>
      <geometry><box size="${pelvis_d} ${pelvis_w} ${pelvis_h}"/></geometry>
      <material name="dark_gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
  </link>
  
  <xacro:macro name="leg" params="side reflect">
    <joint name="${side}_hip_joint" type="revolute">
      <parent link="pelvis_link"/>
      <child link="${side}_thigh_link"/>
      <origin xyz="0 ${reflect * hip_offset_y} ${-pelvis_h/2}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="200" velocity="5"/>
    </joint>
    
    <link name="${side}_thigh_link">
      <inertial>
        <origin xyz="0 0 ${-thigh_length/2}"/>
        <mass value="5.0"/>
        <xacro:cylinder_inertia m="5.0" r="${thigh_radius}" l="${thigh_length}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${-thigh_length/2}"/>
        <geometry><cylinder radius="${thigh_radius}" length="${thigh_length}"/></geometry>
        <material name="blue"><color rgba="0.2 0.2 0.7 1"/></material>
      </visual>
    </link>
    
    <joint name="${side}_knee_joint" type="revolute">
      <parent link="${side}_thigh_link"/>
      <child link="${side}_shank_link"/>
      <origin xyz="0 0 ${-thigh_length}"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="2.5" effort="200" velocity="5"/>
    </joint>
    
    <link name="${side}_shank_link">
      <inertial>
        <origin xyz="0 0 ${-shank_length/2}"/>
        <mass value="3.0"/>
        <xacro:cylinder_inertia m="3.0" r="${shank_radius}" l="${shank_length}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${-shank_length/2}"/>
        <geometry><cylinder radius="${shank_radius}" length="${shank_length}"/></geometry>
        <material name="blue"/>
      </visual>
    </link>
    
    <joint name="${side}_ankle_joint" type="revolute">
      <parent link="${side}_shank_link"/>
      <child link="${side}_foot_link"/>
      <origin xyz="0 0 ${-shank_length}"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.7" upper="0.7" effort="100" velocity="5"/>
    </joint>
    
    <link name="${side}_foot_link">
      <inertial>
        <origin xyz="${foot_length/4} 0 ${-foot_height/2}"/>
        <mass value="1.0"/>
        <xacro:box_inertia m="1.0" x="${foot_length}" y="${foot_width}" z="${foot_height}"/>
      </inertial>
      <visual>
        <origin xyz="${foot_length/4} 0 ${-foot_height/2}"/>
        <geometry><box size="${foot_length} ${foot_width} ${foot_height}"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
    </link>
  </xacro:macro>
  
  <xacro:leg side="L" reflect="1"/>
  <xacro:leg side="R" reflect="-1"/>
  
  <ros2_control name="PatientGazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="base_x_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_z_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="L_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="L_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="L_ankle_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="R_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="R_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="R_ankle_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="patient_gazebo_ros2_control">
      <ros>
        <namespace>/patient</namespace>
      </ros>
      <parameters>${ctrl_yaml}</parameters>
      <controller_manager_node_name>controller_manager</controller_manager_node_name>
      <robot_param>robot_description</robot_param>
      <robot_param_node>patient_state_publisher</robot_param_node>
    </plugin>
  </gazebo>
  
</robot>
