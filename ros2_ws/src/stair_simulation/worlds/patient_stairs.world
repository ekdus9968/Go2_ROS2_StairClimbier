<?xml version="1.0"?>
<sdf version="1.6">
  <world name="patient_stairs">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    
    <!-- 8단 계단, 환자 사양 -->
    <model name="patient_stairs">
      <static>true</static>
      
      <!-- Step 1 -->
      <link name="step1">
        <pose>1.0 0 0.09 0 0 0</pose>
        <collision name="col1">
          <geometry><box><size>0.28 1.2 0.18</size></box></geometry>
        </collision>
        <visual name="vis1">
          <geometry><box><size>0.28 1.2 0.18</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient></material>
        </visual>
      </link>
      
      <!-- Step 2 -->
      <link name="step2">
        <pose>1.28 0 0.27 0 0 0</pose>
        <collision name="col2">
          <geometry><box><size>0.28 1.2 0.18</size></box></geometry>
        </collision>
        <visual name="vis2">
          <geometry><box><size>0.28 1.2 0.18</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient></material>
        </visual>
      </link>
      
      <!-- Step 3 -->
      <link name="step3">
        <pose>1.56 0 0.45 0 0 0</pose>
        <collision name="col3">
          <geometry><box><size>0.28 1.2 0.18</size></box></geometry>
        </collision>
        <visual name="vis3">
          <geometry><box><size>0.28 1.2 0.18</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient></material>
        </visual>
      </link>
      
      <!-- step4 ~ step8 추가 -->
      <!-- 패턴: pose x += 0.28, z += 0.18 -->
      
    </model>
    
    <!-- 위쪽 평면 (계단 도착점) -->
    <model name="top_platform">
      <static>true</static>
      <link name="platform">
        <pose>3.5 0 1.44 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>2.0 2.0 0.02</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>2.0 2.0 0.02</size></box></geometry>
        </visual>
      </link>
    </model>
    
    <!-- 환자 위치 마커 (단순 box) -->
    <model name="patient_marker">
      <pose>2.0 0 1.0 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>50</mass>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.4 0.3 1.7</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.3 1.7</size></box></geometry>
          <material><ambient>1.0 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>
    
  </world>
</sdf>
